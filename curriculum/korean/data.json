 "pronKey": [
  "Hyphens split syllables. Each Hangul block is one syllable, and Korean has no stress marks, so stay light and even.",
  "ㅓ (eo) is an open uh, not o. ㅗ (o) is round. Keep them apart.",
  "ㅡ (eu) has no English twin: lips spread, say uh.",
  "ㄱ ㄷ ㅂ ㅈ sit between g/k, d/t, b/p, and j/ch. Their voice depends on position in the word.",
  "Tense consonants ㄲ ㄸ ㅃ ㅆ ㅉ come with no puff of air. Aspirated ㅋ ㅌ ㅍ ㅊ come with one."
 ],
 "pronNotes": [
  {
   "ko": "한국어",
   "note": "hang-gu-geo. The ㄱ between two vowels softens toward g."
  },
  {
   "ko": "감사합니다",
   "note": "gam-sa-ham-ni-da. ㅂ before ㄴ is said as m, so 합니다 sounds like ham-ni-da."
  },
  {
   "ko": "좋아요",
   "note": "jo-a-yo. The ㅎ in 좋 goes silent before a vowel."
  },
  {
   "ko": "있어요",
   "note": "i-sseo-yo. The final ㅆ carries into the next syllable."
  }
 ],
